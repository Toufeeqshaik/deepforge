# Backend Environment Variables
# Copy to .env for local development

# App
DEEPFORGE_DEBUG=True
DEEPFORGE_MODEL_DEVICE=cpu
DEEPFORGE_TORCH_NUM_THREADS=8

# CORS (comma-separated, for production add your Vercel URL)
DEEPFORGE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Hugging Face Token (optional, for higher rate limits)
HF_TOKEN=

# For production, set these:
# DEEPFORGE_DEBUG=False
# DEEPFORGE_CORS_ORIGINS=https://your-frontend.vercel.app
# DEEPFORGE_MODEL_DEVICE=cpu  # or cuda if GPU available